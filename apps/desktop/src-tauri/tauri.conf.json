{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tabawake",
  "version": "0.1.0",
  "identifier": "com.armancharan.tabawake",
  "build": {
    "beforeBuildCommand": "pnpm --dir ../../.. --filter @tabawake/web build",
    "beforeDevCommand": "pnpm --dir ../../.. --filter @tabawake/web dev",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../web/dist"
  },
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "height": 780,
        "label": "main",
        "resizable": true,
        "title": "tabawake",
        "width": 420
      }
    ]
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.png"],
    "targets": ["dmg", "app"]
  }
}
