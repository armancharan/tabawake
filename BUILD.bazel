package(default_visibility = ["//visibility:public"])

exports_files([
    "package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
])

filegroup(
    name = "all_srcs",
    srcs = glob(
        [
            "**/*",
        ],
        exclude = [
            "**/.git/**",
            "apps/web/dist/**",
            "apps/web/node_modules/**",
            "bazel-*/**",
            "node_modules/**",
        ],
    ),
)
